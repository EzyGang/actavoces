{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "actavoces",
  "version": "0.1.0",
  "identifier": "com.ezygang.actavoces",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "actavoces",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../worker/app": "worker/app",
      "../worker/pyproject.toml": "worker/pyproject.toml",
      "../worker/uv.lock": "worker/uv.lock",
      "resources/runtime/uv": "runtime/uv",
      "resources/runtime/ffmpeg": "runtime/ffmpeg"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
